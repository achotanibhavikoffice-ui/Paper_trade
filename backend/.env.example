APP_ENV=development
DATABASE_URL=postgresql+psycopg://tradeo:tradeo_local_only@localhost:5432/tradeo
JWT_SECRET=replace-with-a-long-random-secret-before-running
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tradeo.noreply@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=tradeo.noreply@gmail.com
SMTP_FROM_NAME=Tradeo
SMTP_STARTTLS=true

# 021 developer API credentials (used only by the backend; never put these in frontend/.env)
MARKET_DATA_ENABLED=false
# Development-only synthetic feed for charts and paper-order practice.
DEMO_MARKET_DATA_ENABLED=true
MARKET_DATA_USERNAME=YOUR_UCC
MARKET_DATA_PASSWORD=YOUR_PASSWORD
MARKET_DATA_API_BASE_URL=https://devapi.021.trade/api/developer-api/v1
MARKET_DATA_WS_BASE_URL=wss://devapi.021.trade/api/developer/websocket/market
MARKET_DATA_DEFAULT_SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,SBIN
MARKET_DATA_SYNC_ON_STARTUP=true
MARKET_DATA_MAX_SUBSCRIPTIONS=100


# Marketaux financial news (server-side only; never prefix with VITE_). Get a token at https://www.marketaux.com
MARKETAUX_API_TOKEN=your-marketaux-api-token
# Free plan returns max 3 articles per request; raise on paid plans.
MARKETAUX_MAX_LIMIT=3
MARKETAUX_CACHE_TTL_SECONDS=900
MARKETAUX_STALE_TTL_SECONDS=86400
MARKETAUX_TIMEOUT_SECONDS=20
# Appended to Tradeo NSE symbols when querying Marketaux (e.g. RELIANCE -> RELIANCE.NS)
MARKETAUX_NSE_SYMBOL_SUFFIX=.NS

# IndianAPI reference data (server-side only; never prefix with VITE_). Get a key at https://indianapi.in
# Powers real daily chart history, market movers and company snapshots.
INDIAN_API_KEY=your-indianapi-key
INDIAN_API_BASE_URL=https://stock.indianapi.in
INDIAN_API_TIMEOUT_SECONDS=20
# Cache lifetimes (seconds). Stale cache is served if the provider fails or the quota runs out.
INDIAN_API_HISTORY_TTL_SECONDS=21600
INDIAN_API_PROFILE_TTL_SECONDS=3600
INDIAN_API_LISTS_TTL_SECONDS=300
INDIAN_API_STALE_TTL_SECONDS=604800
